// __PDK_180NM__ antenna check for aegis_chip
LAYOUT PATH    "LAYOUT_GDS"
LAYOUT PRIMARY "aegis_chip"
LAYOUT SYSTEM GDSII
DRC RESULTS DATABASE "ant.results" ASCII
DRC SUMMARY REPORT   "ant.summary" REPLACE HIER
DRC CELL NAME YES CELL SPACE XFORM
EXCLUDE CELL MEM_SP_2048x36 MEM_SP_4096x52 MEM_SP_64x32
#define __METAL_STACK__
INCLUDE "$PDK_ROOT/pdk/cdns/__PDK_DIR__/HOTCODE/techs/__TECH__/calibre/t.00_00_01_scr/ANTENNA___TECH___CALIBRE"
